/* GraphViewer — Light Theme
   Mirrors dark.qss with inverted neutrals:
     bg-base #f7f8fb  bg-surface #ffffff  bg-elevated #f0f2f7
     border-subtle #e4e7ee  border-default #d4d8e2  border-strong #b4b9c8
     text-primary #1a1d27  text-secondary #6a7088  text-disabled #b0b5c4
     accent #4f7eea  accent-hover #6a98f0  accent-muted #dde6fa
     image-bg #e8ecf3
*/

QMainWindow, QWidget {
    background-color: #f7f8fb;
    color: #1a1d27;
    font-family: "Inter", "Segoe UI Variable", "Segoe UI",
                 "Microsoft YaHei UI", "Noto Sans SC", sans-serif;
    font-size: 13px;
}

QToolTip {
    background-color: #ffffff;
    color: #1a1d27;
    border: 1px solid #d4d8e2;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #f0f2f7;
    width: 10px;
    border: none;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8cdd9;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #b4b9c8; }
QScrollBar:horizontal {
    background: #f0f2f7;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #c8cdd9;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #b4b9c8; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ===== Top app bar ===== */
QWidget#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e4e7ee;
}
QLabel#AppTitle {
    color: #1a1d27;
    font-size: 14px;
    font-weight: 600;
    padding-left: 8px;
}
QLabel#AppVersion {
    color: #6a7088;
    font-size: 11px;
    padding-left: 6px;
}
QLabel#AppAuthor {
    color: #6a7088;
    font-size: 11px;
    padding-left: 6px;
}

QPushButton#IconButton, QToolButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #6a7088;
    min-width: 32px; max-width: 32px;
    min-height: 32px; max-height: 32px;
    padding: 0;
}
QPushButton#IconButton:hover, QToolButton#IconButton:hover {
    background-color: #f0f2f7;
    color: #1a1d27;
}
QPushButton#IconButton:pressed, QToolButton#IconButton:pressed {
    background-color: #e4e7ee;
}
QToolButton#IconButton::menu-indicator { image: none; width: 0; }

/* ===== Menus ===== */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
    color: #1a1d27;
    padding: 4px;
}
QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #dde6fa;
    color: #1a1d27;
}
QMenu::separator {
    height: 1px;
    background: #e4e7ee;
    margin: 4px 6px;
}
QMenu::indicator {
    width: 14px; height: 14px;
    margin-left: 6px;
}

/* ===== Mode Switcher (segmented control) ===== */
QWidget#ModeSwitch {
    background-color: #f7f8fb;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
}
QPushButton#ModeSwitchTab {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6a7088;
    font-size: 13px;
    font-weight: 400;
    min-width: 80px;
    min-height: 26px;
    padding: 0 12px;
}
QPushButton#ModeSwitchTab:checked {
    background-color: #ffffff;
    color: #1a1d27;
    font-weight: 600;
}
QPushButton#ModeSwitchTab:hover:!checked {
    color: #4a4f60;
}

/* ===== Filter Panel ===== */
QWidget#FilterPanel {
    background-color: #ffffff;
    border-right: 1px solid #d4d8e2;
}
QWidget#FilterPanelBody {
    background-color: #ffffff;
}
QScrollArea {
    background-color: #ffffff;
    border: none;
}
QFrame#FilterFooter {
    background-color: #ffffff;
    border-top: 1px solid #e4e7ee;
}
QLabel#FilterSectionTitle {
    color: #6a7088;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 0;
}
QLabel#FilterHint {
    color: #6a7088;
    font-size: 12px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
    color: #1a1d27;
    font-size: 13px;
    min-height: 30px;
    padding: 0 8px 0 10px;
}
QComboBox:hover { border-color: #b4b9c8; }
QComboBox:focus { border-color: #4f7eea; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
    color: #1a1d27;
    selection-background-color: #dde6fa;
    selection-color: #1a1d27;
    padding: 4px;
    outline: 0;
}

/* ===== Filter Chip ===== */
QPushButton#FilterChip {
    background: #ffffff;
    border: 1px solid #d4d8e2;
    border-radius: 3px;
    color: #6a7088;
    font-size: 12px;
    min-height: 26px;
    padding: 0 10px;
}
QPushButton#FilterChip:hover {
    border-color: #b4b9c8;
    color: #1a1d27;
}
QPushButton#FilterChip:checked {
    background-color: #dde6fa;
    border-color: #4f7eea;
    color: #2c5bd6;
    font-weight: 500;
}

/* ===== Buttons ===== */
QPushButton#AccentButton {
    background-color: #4f7eea;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    min-height: 34px;
    padding: 0 16px;
}
QPushButton#AccentButton:hover { background-color: #6a98f0; }
QPushButton#AccentButton:pressed { background-color: #3f6dd8; }
QPushButton#AccentButton:disabled {
    background-color: #dde6fa;
    color: #b0b5c4;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
    color: #6a7088;
    font-size: 13px;
    min-height: 34px;
    padding: 0 16px;
}
QPushButton#GhostButton:hover {
    border-color: #b4b9c8;
    color: #1a1d27;
    background-color: #f0f2f7;
}

/* ===== Image Card ===== */
QFrame#ImageCard {
    background-color: #ffffff;
    border: 1px solid #d4d8e2;
    border-radius: 6px;
}
QFrame#ImageCard[selected="true"] {
    border: 2px solid #4f7eea;
}
QWidget#CardHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e4e7ee;
}
QLabel#CardBreadcrumb {
    color: #6a7088;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}
QLabel#CardZoom {
    color: #6a7088;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e4e7ee;
    color: #6a7088;
    font-size: 11px;
    min-height: 24px;
    max-height: 24px;
    padding: 0 12px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #6a7088; font-size: 11px; }

/* ===== Splitter (free mode) ===== */
QSplitter#FreeSplitter { background-color: #f7f8fb; }
QSplitter::handle { background-color: #e4e7ee; }
QSplitter::handle:hover { background-color: #4f7eea; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }

/* ===== Grid host (网格主区) ===== */
QWidget#GridHost { background-color: #f7f8fb; }

/* ===== Toolbar labels / hints ===== */
QLabel#ToolbarLabel {
    color: #6a7088;
    font-size: 11px;
    letter-spacing: 0.04em;
}
QLabel#ToolbarHint {
    color: #b0b5c4;
    font-size: 11px;
}

/* ===== Card header action buttons ===== */
QPushButton#CardActionButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6a7088;
    font-size: 11px;
}
QPushButton#CardActionButton:hover {
    background: #f0f2f7;
    color: #1a1d27;
}
QPushButton#CardCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6a7088;
    font-size: 18px;
}
QPushButton#CardCloseButton:hover {
    background: #f0f2f7;
    color: #d64545;
}

/* ===== Status bar separator ===== */
QLabel#StatusSep {
    color: #d4d8e2;
    padding: 0 4px;
}

/* ===== Image viewport area ===== */
QGraphicsView#ImageView {
    background-color: #e8ecf3;
    border: none;
}

/* ===== Empty state ===== */
QLabel#EmptyStateTitle {
    color: #b0b5c4;
    font-size: 13px;
    font-weight: 500;
}
QLabel#EmptyStateHint {
    color: #b0b5c4;
    font-size: 11px;
}

/* ===== Secondary toolbar (grid preset row) ===== */
QWidget#SubToolbar {
    background-color: #f7f8fb;
    border-bottom: 1px solid #e4e7ee;
}

QPushButton#PresetButton {
    background: transparent;
    border: 1px solid #d4d8e2;
    border-radius: 4px;
    color: #6a7088;
    min-width: 44px;
    min-height: 28px;
    padding: 0 8px;
    font-size: 12px;
}
QPushButton#PresetButton:hover {
    border-color: #b4b9c8;
    color: #1a1d27;
}
QPushButton#PresetButton:checked {
    background-color: #dde6fa;
    border-color: #4f7eea;
    color: #2c5bd6;
}

QCheckBox {
    color: #6a7088;
    font-size: 12px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #d4d8e2;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:hover { border-color: #b4b9c8; }
QCheckBox::indicator:checked {
    background: #4f7eea;
    border-color: #4f7eea;
}
